# =============================================================================
# IEUM 환경변수 예시
#
# 사용법: cp .env.example .env 후 값을 채우세요.
# .env 는 git 에 커밋되지 않습니다 (.gitignore 참조).
#
# 이 파일은 두 곳에서 읽힙니다:
#   1) docker-compose.yml  - Compose 가 같은 디렉터리의 .env 를 자동으로 읽음
#   2) Spring Boot         - application.yaml 의 spring.config.import 로 로드
#
# 주의: properties 형식으로 파싱되므로
#   - 값에 따옴표를 쓰지 마세요 (따옴표가 값의 일부가 됩니다)
#   - export 접두사를 쓰지 마세요
#   - 값 안의 백슬래시(\)는 이스케이프 문자로 처리됩니다
# =============================================================================

# --- MySQL (필수) ------------------------------------------------------------
# root 비밀번호. 컨테이너 초기화와 헬스체크에 사용됩니다.
MYSQL_ROOT_PASSWORD=change-me
# 애플리케이션이 사용할 스키마 이름
MYSQL_DATABASE=ieum
# 애플리케이션 접속 계정. 기본값이 없어 비우면 부팅에 실패합니다.
MYSQL_USER=ieum
MYSQL_PASSWORD=change-me
# 호스트에 노출할 포트 (기본 3306)
MYSQL_PORT=3306

# --- Redis (필수) ------------------------------------------------------------
# redis-server --requirepass 로 전달됩니다. 기본값이 없어 비우면 부팅에 실패합니다.
REDIS_PASSWORD=change-me
# 호스트에 노출할 포트 (기본 6379)
REDIS_PORT=6379

# =============================================================================
# 아래는 모두 선택 항목입니다. 주석 처리된 값이 application.yaml 의 기본값이며,
# 필요할 때만 주석을 풀고 덮어쓰세요.
# =============================================================================

# --- 접속 대상 호스트 --------------------------------------------------------
# 로컬에서 Compose 컨테이너에 붙을 때는 기본값(localhost) 그대로 두면 됩니다.
# 앱까지 컨테이너로 띄우거나 원격 DB 를 쓸 때만 변경하세요.
#DB_HOST=localhost
#REDIS_HOST=localhost

# --- 애플리케이션 ------------------------------------------------------------
#SERVER_PORT=8080
# HikariCP 최대 커넥션 수
#DB_POOL_SIZE=20
# 스키마 전략: none | validate | update | create | create-drop
# 운영 환경에서는 반드시 validate 또는 none 을 사용하세요.
#JPA_DDL_AUTO=update

# --- 로깅 --------------------------------------------------------------------
# 쿼리/바인딩 파라미터 로그. 운영 환경에서는 off 또는 warn 을 권장합니다.
#SQL_LOG_LEVEL=debug
#SQL_BIND_LOG_LEVEL=trace

# --- 인증 서버 (ieum-auth) ---------------------------------------------------
#AUTH_SERVER_PORT=8081
# 토큰의 iss 클레임. API 서버의 JWT_ISSUER 와 같아야 합니다.
#JWT_ISSUER=http://localhost:8081
# scripts/gen-jwt-key.sh 출력(Base64 PKCS#8, 한 줄). 비우면 기동 시 임시 키를 만들고 재시작 시 토큰이 전부 무효화됩니다.
#JWT_PRIVATE_KEY=
# 키 교체 시 직전 키를 여기로 옮기고 새 키를 JWT_PRIVATE_KEY 에 넣습니다. 쉼표로 여러 개 가능.
# 옛 키로 서명된 토큰이 모두 만료(ACCESS_TOKEN_TTL)된 뒤 비웁니다.
#JWT_PREVIOUS_KEYS=
#ACCESS_TOKEN_TTL=PT15M
#REFRESH_TOKEN_TTL=P14D
#AUTH_DB_POOL_SIZE=5

# --- API 서버 (ieum-api) 토큰 검증 -------------------------------------------
# 인증 서버의 JWKS 주소. Kubernetes 에서는 인증 서버 Service 주소로 바꿉니다.
#AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json

# --- API 서버 (ieum-api) 예약 -----------------------------------------------
# 재고 차감 전략. naive(잠금 없음, 초과 예약 재현) | optimistic(@Version) | redis(Lua). 부하 테스트 비교용
#STOCK_STRATEGY=naive
# READY_FOR_PICKUP 진입 후 미픽업 만료 시간 (ISO-8601 Duration)
#PICKUP_TTL=PT15M

# --- CORS (두 서버 공통) -----------------------------------------------------
#CORS_ALLOWED_ORIGINS=http://localhost:3000

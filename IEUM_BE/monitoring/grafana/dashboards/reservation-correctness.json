    {
      "type": "stat",
      "title": "재고 불일치 (mismatch)",
      "description": "Reconciliation 이 Redis 재고(stock:{itemId})·활성 예약 집합이 DB 기대값과 다르다고 본 횟수. 커밋 직전 주문과 엇갈리면 부하 중 일시적으로 오를 수 있어 주황. 같은 차이가 두 번 연속이면 corrected 로 이어진다.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "ieum-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ieum-prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(stock_reconciliation_total{job=\"ieum-api\", outcome=\"mismatch\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
